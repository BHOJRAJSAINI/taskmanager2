{
  "functions": {
    "api/rpc.js": { "maxDuration": 60, "memory": 1024 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [ { "key": "Cache-Control", "value": "no-store" } ]
    }
  ]
}
