# --- REQUIRED ---------------------------------------------------------------
# Full service-account JSON (single line) OR its base64. The service account's
# client_email must be added as *Editor* on every Spreadsheet + the photo Drive folder.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Long random string (>=32 chars). Used to sign login tokens.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- OPTIONAL ---------------------------------------------------------------
# Must match the timezone of your Google Sheets (File > Settings > Time zone).
APP_TIMEZONE=Asia/Kolkata
# New FMS submodule spreadsheets are created here (Drive folder id) if set.
FMS_PARENT_FOLDER_ID=
# Comma-separated emails that get Editor access to every new FMS submodule spreadsheet.
FMS_SHARE_WITH=dasha@global-india.com
# Distributed write-lock across Vercel instances (recommended in production).
# Free Upstash Redis works: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local server only
PORT=3000
